/* 首页：把主视觉、入口、宫格都收进同一套暖色语言 */

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--brand-grad-a), var(--brand-grad-b));
  border-radius: var(--r-lg);
  padding: 40rpx 200rpx 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(233, 96, 58, 0.22);
}

/* 欢迎栏右侧的小人 */
/* 小人的容器：负责位移与淡入淡出，canvas 只负责画动作 */
.hero-fig-wrap {
  position: absolute;
  right: 20rpx;
  top: 50%;
  width: 156rpx;
  height: 156rpx;
  margin-top: -78rpx;
  transition: transform 0.5s cubic-bezier(0.22, 0.8, 0.3, 1), opacity 0.5s ease;
}

/* 点一下：往右跑出画面（1 秒内） */
.hero-fig-wrap.run {
  transform: translateX(260%);
  opacity: 0;
  transition: transform 0.9s cubic-bezier(0.3, 0, 1, 0.7), opacity 0.9s ease;
}

/* 瞬间移到左边画面外（不要过渡，避免看到穿场） */
.hero-fig-wrap.reenter {
  transform: translateX(-260%);
  opacity: 0;
  transition: none;
}

.hero-canvas {
  width: 156rpx;
  height: 156rpx;
  display: block;
}
.hero .hello { font-size: 40rpx; font-weight: 600; letter-spacing: 0.5rpx; }
.hero .sub { font-size: 24rpx; opacity: 0.92; margin-top: 10rpx; }

/* 入场码单独成块，管理员可以拖到任意位置 */
.entry-card { margin-bottom: 24rpx; }
.entry-btn {
  background: var(--surface);
  color: var(--brand);
  border-radius: var(--r-md);
  padding: 28rpx 24rpx;
  text-align: center;
  border: 1rpx solid var(--brand-line);
  box-shadow: var(--shadow);
}
.entry-btn:active { background: var(--brand-soft); }
.entry-text { font-size: 34rpx; font-weight: 600; }
.entry-sub { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }

/* 快捷宫格 */
.quick { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.q {
  flex: 1;
  min-width: 40%;
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.q + .q { margin-left: 24rpx; }
.q:nth-child(2n+1) { margin-left: 0; }
.q:active { background: var(--line-soft); }
.q .q-t { font-size: 30rpx; font-weight: 600; color: var(--ink); }

.profile-tip {
  border: 1rpx solid var(--brand-line);
  background: var(--brand-soft);
  box-shadow: none;
}

/* 排行榜条形图：用 view 宽度百分比画，不引图表库 */
.rank-row { align-items: flex-start; }
.bar-track {
  height: 10rpx;
  border-radius: var(--r-pill);
  background: var(--fill);
  margin: 10rpx 0 6rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--brand-line);
  transition: width 0.35s ease;
}
/* 第一名用实色突出，其余用浅色，避免整屏都在抢注意力 */
.bar-fill.first {
  background: linear-gradient(90deg, var(--brand-grad-a), var(--brand-grad-b));
}

/* 自定义快捷入口卡片 */
.link-card { display: flex; align-items: center; }
.link-card:active { background: var(--line-soft); }
/* 快捷入口图标：没选图标时不渲染这个节点，选了就按原样显示 */
.link-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: var(--r-md);
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

/* 友圈预览 */
.moment-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}
.moment-row:last-child { margin-bottom: 24rpx; }
.moment-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-sm);
  margin-left: 20rpx;
  background: var(--fill);
}

/* ---------- 快捷入口：六边形能力图 ---------- */
.q-rank { display: flex; flex-direction: column; }

.radar-wrap {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}
.radar {
  width: 220rpx;
  height: 220rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.radar-empty {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
}
.radar-hint { font-size: 22rpx; color: var(--muted); }

/* ---------- 快捷入口：友圈缩略图 ---------- */
.q-moments { display: flex; flex-direction: column; }

.thumbs {
  display: flex;
  gap: 12rpx;
  height: 150rpx;
  margin-top: 12rpx;
}
.thumb-wrap {
  flex: 1;
  position: relative;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--fill);
}
.thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.thumb-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  line-height: 40rpx;
  text-align: center;
}
.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.thumb-empty-t { font-size: 22rpx; color: var(--muted); }

/* 首页挑战模块 */
.challenge-home { display: block; }
.challenge-todo { font-size: 26rpx; color: var(--brand-strong); }
.todo-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.challenge-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.challenge-link { font-size: 26rpx; color: var(--brand-strong); font-weight: 600; }
