<view class="page">
  <view class="card box">
    <block wx:if="{{error}}">
      <view class="title">无法生成入场码</view>
      <view class="muted mt">{{error}}</view>
    </block>
    <block wx:else>
      <view class="title">{{cardName || '加载中…'}}</view>
      <view class="muted">{{cardInfo}}</view>
      <image wx:if="{{image}}" class="qr" src="{{image}}" mode="aspectFit" />
      <view wx:else class="qr placeholder"></view>
      <view class="muted">请向前台出示，{{countdown}} 秒后自动刷新</view>
      <view class="muted">截图无效，每天首次入场 +10 积分</view>
    </block>
  </view>
</view>
