<view class="page">
  <view wx:if="{{loaded && !hasBody}}" class="card">
    <view class="title">还没有身体数据</view>
    <view class="muted mt">身体数据由前台或教练用体测设备测量后录入。录入后会在这里看到体重、体脂率和身体评分。</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="between">
        <text class="title">身体评分</text>
        <view class="row">
          <text wx:if="{{f.latestBody.deviceScore}}" class="tag">设备 {{f.latestBody.deviceScore}} 分</text>
          <text class="tag orange">{{score}} 分</text>
        </view>
      </view>
      <view class="muted mt">{{f.latestBody.date}} 测量{{f.latestBody.deviceName ? ' · ' + f.latestBody.deviceName : ''}}</view>
      <view wx:for="{{scoreDetail}}" wx:key="key" class="form-row">
        <text class="label">{{item.label}}</text>
        <text class="grow">{{item.score}} / {{item.max}}</text>
      </view>
      <view class="muted mt">评分 = 体脂率 40 + 相对力量 40 + 体重指数 20，缺项自动归一</view>
    </view>

    <view wx:if="{{metrics.length}}" class="section-title">身体指标</view>
    <view wx:if="{{metrics.length}}" class="card">
      <view class="grid">
        <view wx:for="{{metrics}}" wx:key="key" class="grid-cell">
          <view class="grid-v">{{item.value}}<text wx:if="{{item.unit}}" class="grid-u">{{item.unit}}</text></view>
          <view class="muted">{{item.name}}</view>
        </view>
      </view>
      <view wx:if="{{f.latestBody.bodyShape || f.latestBody.bodyType}}" class="muted mt">
        体态：{{f.latestBody.bodyShape || '-'}} · {{f.latestBody.bodyType || '-'}}
      </view>
      <image wx:if="{{f.latestBody.reportImage}}" class="report" src="{{f.latestBody.reportImage}}" mode="aspectFill" />
    </view>

    <view wx:if="{{seg}}" class="section-title">节段分析</view>
    <view wx:if="{{seg}}" class="card">
      <view class="seg-tabs">
        <view wx:if="{{seg.fat}}" class="seg-tab {{segTab === 'fat' ? 'on' : ''}}" data-tab="fat" bindtap="pickSegTab">脂肪</view>
        <view wx:if="{{seg.muscle}}" class="seg-tab {{segTab === 'muscle' ? 'on' : ''}}" data-tab="muscle" bindtap="pickSegTab">肌肉</view>
      </view>

      <view class="body-map">
        <view class="seg-head"></view>
        <view wx:for="{{segCurrent.cells}}" wx:key="key" class="seg {{item.cls}}">
          <view class="seg-v">{{item.value}}<text class="seg-u">kg</text></view>
          <view class="seg-n">{{item.name}}</view>
        </view>
      </view>

      <view class="seg-summary">
        <view class="seg-line">
          <text>上肢</text>
          <text class="seg-badge {{segCurrent.arms === '均衡' ? 'ok' : 'warn'}}">{{segCurrent.arms || '数据不足'}}</text>
          <text wx:if="{{segCurrent.armDiff !== null}}" class="muted">左右差 {{segCurrent.armDiff}} kg</text>
        </view>
        <view class="seg-line">
          <text>下肢</text>
          <text class="seg-badge {{segCurrent.legs === '均衡' ? 'ok' : 'warn'}}">{{segCurrent.legs || '数据不足'}}</text>
          <text wx:if="{{segCurrent.legDiff !== null}}" class="muted">左右差 {{segCurrent.legDiff}} kg</text>
        </view>
      </view>
      <view class="muted mt">只做自身左右对比（相差 ≤ 0.3kg 记为均衡），不代表人群标准。</view>
    </view>

    <view class="section-title">数据变化</view>
    <view class="card">
      <view class="row">
        <view wx:for="{{periods}}" wx:key="days" class="period {{days === item.days ? 'on' : ''}}"
          data-days="{{item.days}}" bindtap="pickPeriod">{{item.label}}</view>
      </view>
      <view wx:if="{{trend && trend.count < 2}}" class="muted mt">这个时间段内只有 {{trend.count}} 条记录，至少 2 次测量才能看变化。</view>
      <block wx:else>
        <view wx:if="{{trend.hasDelta}}" class="mt">
          <text class="muted">体重</text>
          <text class="delta {{trend.dWeight > 0 ? 'up' : 'down'}}">{{trend.dWeight > 0 ? '+' : ''}}{{trend.dWeight}} kg</text>
          <text wx:if="{{trend.dFat !== null}}" class="muted"> · 体脂 </text>
          <text wx:if="{{trend.dFat !== null}}" class="delta {{trend.dFat > 0 ? 'up' : 'down'}}">{{trend.dFat > 0 ? '+' : ''}}{{trend.dFat}}%</text>
          <text wx:if="{{trend.dScore !== null}}" class="muted"> · 评分 </text>
          <text wx:if="{{trend.dScore !== null}}" class="delta {{trend.dScore > 0 ? 'down' : 'up'}}">{{trend.dScore > 0 ? '+' : ''}}{{trend.dScore}}</text>
        </view>
        <view class="muted mt">{{trend.from}} 起共 {{trend.count}} 次测量</view>
        <view wx:for="{{trendList}}" wx:key="date" class="list-item">
          <text class="grow">{{item.date}}</text>
          <text class="muted">{{item.weight}} kg · {{item.bodyFat}}% · {{item.score}} 分</text>
        </view>
      </block>
    </view>

    <view class="card">
      <view class="between">
        <view>
          <view>公开身体数据</view>
          <view class="muted mt">开启后别人能在排行榜看到你的体重和身体评分</view>
        </view>
        <switch checked="{{isPublic}}" bindchange="togglePublic" />
      </view>
    </view>

    <view class="between section-title">
      <text>力量最佳</text>
      <button class="btn ghost" bindtap="goRank">排行榜</button>
    </view>
    <view class="card">
      <view wx:for="{{bestList}}" wx:key="key" class="list-item">
        <text class="grow">{{item.name}}</text>
        <text wx:if="{{item.has}}" class="price">{{item.oneRM}} kg</text>
        <text wx:else class="muted">暂无成绩</text>
      </view>
    </view>

    <view class="section-title">身体数据历史</view>
    <view class="card">
      <view wx:if="{{!bodyList.length}}" class="muted">暂无记录</view>
      <view wx:for="{{bodyList}}" wx:key="id" class="list-item">
        <view class="grow">
          <view>{{item.date}}</view>
          <view class="muted">BMI {{item.bmi}} · 评分 {{item.score}}{{item.deviceScore ? ' · 设备 ' + item.deviceScore : ''}}</view>
        </view>
        <view class="muted">{{item.weight}} kg · {{item.bodyFat}}%</view>
      </view>
    </view>
  </block>
</view>
