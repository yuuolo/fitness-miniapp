/* 「我的」页面：个人卡片 / 功能菜单 / 积分 */

/* 头像：加一圈品牌色描边，视觉重心更集中 */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--fill);
  flex-shrink: 0;
  box-shadow: 0 0 0 3rpx var(--surface), 0 0 0 5rpx var(--brand-line);
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ph);
}

.profile-card { padding: 28rpx; }
.profile-card:active { background: var(--line-soft); }

/* 菜单：每行带图标，右侧统一箭头 */
.menu { padding: 8rpx 28rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--line-soft); }
.mi-icon {
  width: 52rpx;
  font-size: 30rpx;
  flex: none;
}
.chevron {
  color: var(--ph);
  font-size: 32rpx;
  margin-left: 12rpx;
  flex: none;
}

/* 积分卡片 */
.points-card {
  background: linear-gradient(135deg, var(--brand-grad-a), var(--brand-grad-b));
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(233, 96, 58, 0.2);
}
.points-card .muted { color: rgba(255, 255, 255, 0.85); }
.points-n {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-top: 4rpx;
}
