/* 「我的」页面：个人卡片 / 功能菜单 / 积分 */

/* 头像：加一圈品牌色描边，视觉重心更集中 */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--fill);
  flex-shrink: 0;
  box-shadow: 0 0 0 3rpx var(--surface), 0 0 0 5rpx var(--brand-line);
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ph);
}

.profile-card { padding: 28rpx; }
.profile-card:active { background: var(--line-soft); }

/* 菜单：每行带图标，右侧统一箭头 */
.menu { padding: 8rpx 28rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--line-soft); }
.chevron {
  color: var(--ph);
  font-size: 32rpx;
  margin-left: 12rpx;
  flex: none;
}

/* 积分卡片 */
.points-card {
  background: linear-gradient(135deg, var(--brand-grad-a), var(--brand-grad-b));
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(233, 96, 58, 0.2);
}
.points-card .muted { color: rgba(255, 255, 255, 0.85); }
.points-n {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-top: 4rpx;
}

/* 外观切换：三段式选择器 */
.title-sm {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.seg {
  display: flex;
  background: var(--fill);
  border-radius: var(--r-pill);
  padding: 4rpx;
  flex: none;
}
.seg-item {
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  color: var(--sub);
  white-space: nowrap;
}
.seg-item.on {
  background: var(--surface);
  color: var(--brand);
  font-weight: 600;
  box-shadow: var(--shadow);
}

/* 图标：内联 SVG（不用 emoji，避免各系统字形/颜色不一致） */
.mi {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
}
.mi-card { background-image: url("data:image/svg+xml;base64,"); }
.mi-list { background-image: url("data:image/svg+xml;base64,"); }
.mi-chart { background-image: url("data:image/svg+xml;base64,"); }
.mi-trophy { background-image: url("data:image/svg+xml;base64,"); }
.mi-flame { background-image: url("data:image/svg+xml;base64,"); }
.mi-tool { background-image: url("data:image/svg+xml;base64,"); }
