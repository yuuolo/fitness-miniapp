/* 「我的」页面：个人卡片 / 功能菜单 */

/* 头像：加一圈品牌色描边，视觉重心更集中 */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--fill);
  flex-shrink: 0;
  box-shadow: 0 0 0 3rpx var(--surface), 0 0 0 5rpx var(--brand-line);
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ph);
}

.profile-card { padding: 28rpx; }
.profile-card:active { background: var(--line-soft); }

/* 菜单：每行带图标，右侧统一箭头 */
.menu { padding: 8rpx 28rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--line-soft); }
.chevron {
  color: var(--ph);
  font-size: 32rpx;
  margin-left: 12rpx;
  flex: none;
}




/* 算法说明图标：一本书 */
.mi-book {
  background: var(--brand-soft);
  border-radius: 10rpx;
  position: relative;
}
.mi-book::before {
  content: '';
  position: absolute;
  left: 25%;
  top: 22%;
  width: 50%;
  height: 56%;
  border: 3rpx solid var(--brand-strong);
  border-radius: 3rpx;
  border-left-width: 7rpx;
}
.mi-book::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 26%;
  width: 2rpx;
  height: 46%;
  background: var(--brand-strong);
  opacity: .6;
}
