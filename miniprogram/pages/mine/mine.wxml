<view class="page">
  <view wx:if="{{loaded && !initialized}}" class="card">
    <view class="title">系统尚未初始化</view>
    <view class="muted mt">首次部署后，由店长或管理员点击下方按钮完成初始化。第一个点击的人会成为管理员。</view>
    <button class="btn block mt" bindtap="bootstrap">初始化系统</button>
  </view>

  <block wx:else>
    <!-- 个人卡片 -->
    <view class="card profile-card" bindtap="goProfile">
      <view class="between">
        <view class="row">
          <image wx:if="{{me.avatar}}" class="avatar" src="{{me.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-empty">＋</view>
          <view class="ml">
            <view class="row">
              <text class="title">{{me.nickName || '点击完善资料'}}</text>
              <text class="tag orange ml-sm">{{roleName}}</text>
            </view>
            <view class="muted mt-sm">{{me.phone || '手机号未填写'}}</view>
          </view>
        </view>
        <text class="chevron">›</text>
      </view>
      <view wx:if="{{blockedText}}" class="tag red mt">{{blockedText}}</view>
    </view>

    <!-- 功能菜单 -->
    <view class="card menu">
      <view wx:if="{{features.fitness !== false}}" class="menu-item" bindtap="goFitness">
        <view class="mi mi-chart"></view><text class="grow">我的身体数据</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.rank !== false}}" class="menu-item" bindtap="goChallenges">
        <view class="mi mi-duel"></view><text class="grow">会员挑战</text>
        <text wx:if="{{challengeBadge}}" class="tag orange">{{challengeBadge}}</text>
        <text class="chevron">›</text>
      </view>
      <view wx:if="{{features.rank !== false}}" class="menu-item" bindtap="goRank">
        <view class="mi mi-trophy"></view><text class="grow">力量排行榜</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.rank !== false}}" class="menu-item" bindtap="goCompetitions">
        <view class="mi mi-flame"></view><text class="grow">竞赛</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.fitness !== false}}" class="menu-item" bindtap="goActivity">
        <view class="mi mi-run"></view><text class="grow">记录运动</text><text class="chevron">›</text>
      </view>
      <view class="menu-item" bindtap="goManual">
        <view class="mi mi-book"></view><text class="grow">算法说明</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{isStaff}}" class="menu-item" bindtap="goStaff">
        <view class="mi mi-tool"></view><text class="grow">员工工作台</text><text class="chevron">›</text>
      </view>
    </view>

  </block>
</view>
