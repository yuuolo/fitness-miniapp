<view class="page {{themeClass}}">
  <view wx:if="{{loaded && !initialized}}" class="card">
    <view class="title">系统尚未初始化</view>
    <view class="muted mt">首次部署后，由店长或管理员点击下方按钮完成初始化。第一个点击的人会成为管理员。</view>
    <button class="btn block mt" bindtap="bootstrap">初始化系统</button>
  </view>

  <block wx:else>
    <!-- 个人卡片 -->
    <view class="card profile-card" bindtap="goProfile">
      <view class="between">
        <view class="row">
          <image wx:if="{{me.avatar}}" class="avatar" src="{{me.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-empty">＋</view>
          <view class="ml">
            <view class="row">
              <text class="title">{{me.nickName || '点击完善资料'}}</text>
              <text class="tag orange ml-sm">{{roleName}}</text>
            </view>
            <view class="muted mt-sm">{{me.phone || '手机号未填写'}}</view>
          </view>
        </view>
        <text class="chevron">›</text>
      </view>
      <view wx:if="{{blockedText}}" class="tag red mt">{{blockedText}}</view>
    </view>

    <!-- 功能菜单 -->
    <view class="card menu">
      <view wx:if="{{features.cards !== false}}" class="menu-item" bindtap="goCards">
        <view class="mi mi-card"></view><text class="grow">我的会员卡</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.classes !== false || features.venues !== false}}" class="menu-item" bindtap="goBookings">
        <view class="mi mi-list"></view><text class="grow">我的预约</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.fitness !== false}}" class="menu-item" bindtap="goFitness">
        <view class="mi mi-chart"></view><text class="grow">我的身体数据</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.rank !== false}}" class="menu-item" bindtap="goRank">
        <view class="mi mi-trophy"></view><text class="grow">力量排行榜</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{features.rank !== false}}" class="menu-item" bindtap="goCompetitions">
        <view class="mi mi-flame"></view><text class="grow">竞赛</text><text class="chevron">›</text>
      </view>
      <view wx:if="{{isStaff}}" class="menu-item" bindtap="goStaff">
        <view class="mi mi-tool"></view><text class="grow">员工工作台</text><text class="chevron">›</text>
      </view>
    </view>

    <!-- 外观切换 -->
    <view class="card">
      <view class="between">
        <view>
          <view class="title-sm">外观</view>
          <view class="muted">深色模式可手动切换，也可以跟随系统</view>
        </view>
        <view class="seg">
          <view wx:for="{{themeOptions}}" wx:key="value"
            class="seg-item {{themeMode === item.value ? 'on' : ''}}"
            data-mode="{{item.value}}" bindtap="onTheme">{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 积分（可在管理页关掉） -->
    <block wx:if="{{features.points !== false}}">
      <view class="card points-card">
        <view class="between">
          <view>
            <view class="muted">我的积分</view>
            <view class="points-n">{{me.points || 0}}</view>
          </view>
          <text class="muted">每天首次到店 +10，上课签到 +5</text>
        </view>
      </view>

      <view class="card">
        <view wx:if="{{!logs.length}}" class="empty sm">还没有积分记录</view>
        <view wx:for="{{logs}}" wx:key="_id" class="list-item">
          <view class="grow">
            <view>{{item.source}}</view>
            <view class="muted">{{item.time}}</view>
          </view>
          <text class="price">{{item.change > 0 ? '+' : ''}}{{item.change}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
