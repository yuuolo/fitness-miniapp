<view class="page">
  <view class="card">
    <view class="avatar-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{uploading}}">
        <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-empty">＋</view>
      </button>
      <view class="grow">
        <view>头像</view>
        <view class="muted">点一下可以用微信头像</view>
      </view>
    </view>

    <view class="form-row">
      <text class="label">昵称</text>
      <input type="nickname" value="{{nickName}}" bindinput="onNick" bindblur="onNick"
        placeholder="点击可用微信昵称" maxlength="20" />
    </view>

    <view class="form-row">
      <text class="label">手机号</text>
      <input type="number" value="{{phone}}" bindinput="onPhone" maxlength="11"
        placeholder="11 位手机号" />
    </view>

    <button class="btn block mt" bindtap="save" disabled="{{saving || uploading}}">保存</button>
  </view>

  <view class="card">
    <view class="muted">昵称和头像由微信提供，必须你点一下授权，小程序无法自动获取；手机号需要自己填写，约课时前台要用它联系你。</view>
  </view>
</view>
