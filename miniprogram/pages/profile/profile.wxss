.avatar-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1px solid var(--fill);
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border-radius: 50%;
  line-height: 1;
  overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--fill);
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--ph);
}

.welcome {
  background: linear-gradient(135deg, var(--brand-soft), var(--surface));
  border: 1px solid var(--brand-line);
}
