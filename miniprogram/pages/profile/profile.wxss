.avatar-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1px solid #f0f1f4;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border-radius: 50%;
  line-height: 1;
  overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f1f4;
}
.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #b8bcc4;
}

.welcome {
  background: linear-gradient(135deg, #fff5f0, #fff);
  border: 1px solid #ffe0d3;
}
