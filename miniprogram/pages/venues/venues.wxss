/* 娱乐预约：项目切换 + 时段宫格 */

.tabs { white-space: nowrap; margin-bottom: 24rpx; }

.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--sub);
  box-shadow: var(--shadow);
}
.tab.on {
  background: var(--brand);
  color: #fff;
  box-shadow: none;
}

.grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }

.slot {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  background: var(--surface);
  border-radius: var(--r-sm);
  padding: 16rpx 0;
  text-align: center;
  box-sizing: border-box;
  border: 1rpx solid var(--surface);
  box-shadow: var(--shadow);
}
.slot .s-t { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.slot .s-r { font-size: 22rpx; color: var(--ok); }

/* 已约满 / 已过期 */
.slot.off { background: var(--fill); box-shadow: none; }
.slot.off .s-t,
.slot.off .s-r { color: var(--ph); }

/* 我自己约的 */
.slot.mine {
  border-color: var(--brand);
  background: var(--brand-soft);
  box-shadow: none;
}
.slot.mine .s-r { color: var(--brand); }
