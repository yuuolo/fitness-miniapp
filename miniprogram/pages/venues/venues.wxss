.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  color: var(--sub);
}
.tab.on { background: var(--brand); color: #fff; }
.grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.slot {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  box-sizing: border-box;
  border: 1px solid #fff;
}
.slot .s-t { font-size: 30rpx; font-weight: 600; }
.slot .s-r { font-size: 22rpx; color: var(--ok); }
.slot.off { background: var(--fill); }
.slot.off .s-t, .slot.off .s-r { color: var(--ph); }
.slot.mine { border-color: var(--brand); background: var(--brand-soft); }
.slot.mine .s-r { color: var(--brand); }
