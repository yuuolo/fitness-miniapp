.prize-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--brand-soft);
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--brand-strong);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.value-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.video-link {
  font-size: 22rpx;
  color: var(--brand);
  border: 1px solid var(--brand);
  border-radius: var(--r-md);
  padding: 2rpx 14rpx;
}
