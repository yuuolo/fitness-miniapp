.prize-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff8f4;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #c2501f;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.value-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.video-link {
  font-size: 22rpx;
  color: #ff6a3d;
  border: 1px solid #ff6a3d;
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
}
