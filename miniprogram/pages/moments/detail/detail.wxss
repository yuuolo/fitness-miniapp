.content {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.full-media {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #000;
}
.like {
  font-size: 28rpx;
  color: #8a8f99;
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: #f0f1f4;
}
.like.on {
  color: #ff6a3d;
  background: #fff1eb;
}
