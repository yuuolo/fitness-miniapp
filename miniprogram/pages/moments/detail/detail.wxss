.content {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.full-media {
  width: 100%;
  border-radius: var(--r-sm);
  margin-bottom: 12rpx;
  background: #000;
}
.like {
  font-size: 28rpx;
  color: var(--muted);
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: var(--fill);
}
.like.on {
  color: var(--brand);
  background: var(--brand-soft);
}

/* 海报画布：放到屏幕外，只用于绘制导出，不显示给用户 */
.poster-canvas {
  position: fixed;
  left: -3000rpx;
  top: 0;
  width: 750px;
  height: 1200px;
}

.link {
  color: var(--brand);
  text-decoration: underline;
}

/* 小按钮：点赞行里的「生成海报」/「删除」 */
.mini-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-strong);
  border: none;
}
.mini-btn::after { border: none; }
.mini-btn.gray {
  background: var(--fill);
  color: var(--sub);
}
.mini-btn:active { opacity: .75; }
