.content {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.full-media {
  width: 100%;
  border-radius: var(--r-sm);
  margin-bottom: 12rpx;
  background: #000;
}
.like {
  font-size: 28rpx;
  color: var(--muted);
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: var(--fill);
}
.like.on {
  color: var(--brand);
  background: var(--brand-soft);
}

/* 海报画布：放到屏幕外，只用于绘制导出，不显示给用户 */
.poster-canvas {
  position: fixed;
  left: -3000rpx;
  top: 0;
  width: 750px;
  height: 1200px;
}

.link {
  color: var(--brand);
  text-decoration: underline;
}
