.content {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.full-media {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #000;
}
.like {
  font-size: 28rpx;
  color: #8a8f99;
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: #f0f1f4;
}
.like.on {
  color: #ff6a3d;
  background: #fff1eb;
}

/* 海报画布：放到屏幕外，只用于绘制导出，不显示给用户 */
.poster-canvas {
  position: fixed;
  left: -3000rpx;
  top: 0;
  width: 750px;
  height: 1200px;
}

.link {
  color: #ff6a3d;
  text-decoration: underline;
}
