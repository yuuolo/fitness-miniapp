.media {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.media-item {
  width: 218rpx;
  height: 218rpx;
  border-radius: var(--r-sm);
  background: var(--fill);
}
.like {
  font-size: 26rpx;
  color: var(--muted);
  padding: 4rpx 20rpx;
  border-radius: var(--r-lg);
  background: var(--fill);
}
.like.on {
  color: var(--brand);
  background: var(--brand-soft);
}
