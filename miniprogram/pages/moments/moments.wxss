.media {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.media-item {
  width: 218rpx;
  height: 218rpx;
  border-radius: var(--r-sm);
  background: var(--fill);
}
.like {
  font-size: 26rpx;
  color: var(--muted);
  padding: 4rpx 20rpx;
  border-radius: var(--r-lg);
  background: var(--fill);
}
.like.on {
  color: var(--brand);
  background: var(--brand-soft);
}

/* 动态右下角操作区：删除 + 点赞 */
.moment-ops {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.op-del {
  font-size: 24rpx;
  color: var(--muted);
  padding: 4rpx 8rpx;
}
.op-del:active {
  color: var(--danger);
}

/* 超出的媒体数量提示 */
.media-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(35, 32, 29, 0.55);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
