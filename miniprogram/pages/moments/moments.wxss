/* 友圈头部：左搜索图标 + 右发一条，不放标题 */
.moments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 16rpx;
}
/* 微信 button 默认宽度 184px，这里按内容自适应，靠右放 */
.moments-head .btn {
  width: auto;
  padding: 0 32rpx;
  /* 微信 button 默认左右 margin:auto，会把按钮挤到中间，这里明确靠右 */
  margin-left: auto;
  margin-right: 0;
}
.media {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.media-item {
  width: 218rpx;
  height: 218rpx;
  border-radius: var(--r-sm);
  background: var(--fill);
}
.like {
  font-size: 26rpx;
  color: var(--muted);
  padding: 4rpx 20rpx;
  border-radius: var(--r-lg);
  background: var(--fill);
}
.like.on {
  color: var(--brand);
  background: var(--brand-soft);
}

/* 动态右下角操作区：删除 + 点赞 */
.moment-ops {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.op-del {
  font-size: 24rpx;
  color: var(--muted);
  padding: 4rpx 8rpx;
}
.op-del:active {
  color: var(--danger);
}

/* 超出的媒体数量提示 */
.media-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(35, 32, 29, 0.55);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 搜索栏：输入即预搜 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 0 16rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--fill);
  border-radius: var(--r-pill);
  padding: 0 20rpx;
  height: 68rpx;
}
.search-ico { font-size: 24rpx; opacity: 0.6; }
.search-input { flex: 1; font-size: 26rpx; color: var(--text); }
.search-clear { font-size: 24rpx; color: var(--muted); padding: 0 6rpx; }
.search-chip {
  font-size: 24rpx;
  color: var(--sub);
  background: var(--fill);
  border-radius: var(--r-pill);
  padding: 14rpx 20rpx;
  white-space: nowrap;
}
.search-chip.on { background: var(--brand); color: #fff; }

/* 搜索图标：默认收起，点开才显示搜索栏 */
.search-toggle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.search-toggle.on { background: var(--brand); }
.search-close {
  font-size: 26rpx;
  color: var(--muted);
  padding: 0 6rpx;
}
