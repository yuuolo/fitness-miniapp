.content {
  width: 100%;
  min-height: 180rpx;
  font-size: 30rpx;
  line-height: 1.6;
}
.media {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.media-cell {
  position: relative;
}
.media-item {
  width: 210rpx;
  height: 210rpx;
  border-radius: var(--r-sm);
  background: var(--fill);
}
.media-item.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  color: var(--ph);
  border: 2rpx dashed var(--line);
}
.add-t {
  font-size: 20rpx;
  margin-top: 4rpx;
}
.size {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 18rpx;
  line-height: 26rpx;
}
.del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
}

/* 「选择会员」图标按钮：默认收起列表，点它才展开 */
.pick-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: var(--brand-strong);
  background: var(--fill);
  border-radius: var(--r-pill);
  padding: 10rpx 22rpx;
}
.pick-btn.on { background: var(--brand); color: #fff; }
