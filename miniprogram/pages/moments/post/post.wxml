<view class="page">
  <view class="card">
    <textarea class="content" value="{{content}}" bindinput="onContent" maxlength="500"
      placeholder="今天练了什么？体重体脂有变化吗？" auto-height />
    <view class="muted mt">{{content.length}}/500</view>
  </view>

  <view class="card">
    <view class="media">
      <view wx:for="{{media}}" wx:key="index" class="media-cell">
        <video wx:if="{{item.type === 'video'}}" class="media-item" src="{{item.tempFilePath}}" object-fit="cover"></video>
        <image wx:else class="media-item" src="{{item.tempFilePath}}" mode="aspectFill" />
        <view class="del" catchtap="remove" data-index="{{index}}">×</view>
        <view wx:if="{{item.sizeText}}" class="size">{{item.sizeText}}</view>
      </view>
      <view wx:if="{{media.length < maxCount}}" class="media-item add" bindtap="chooseVideo">＋<text class="add-t">视频</text></view>
      <view wx:if="{{media.length < maxCount}}" class="media-item add" bindtap="chooseImages">＋<text class="add-t">照片</text></view>
    </view>
    <view class="muted mt">{{limitText || '视频限 15 秒，最多 9 个，合计不超过 40 MB'}}；照片会压缩后再上传。</view>
    <view wx:if="{{totalText}}" class="muted">{{totalText}}</view>
  </view>

  <view wx:if="{{canCoach}}" class="card">
    <view class="form-row">
      <text class="label">为谁发布</text>
      <view class="grow" style="text-align:right">
        <text wx:if="{{pickedMember}}" class="tag orange">{{pickedMember.name}}</text>
        <text wx:else class="muted">默认发给我自己</text>
        <text wx:if="{{pickedMember}}" class="muted" style="margin-left:12rpx" bindtap="clearPickedMember">清除</text>
      </view>
    </view>

    <view wx:if="{{!pickedMember}}" class="row mt">
      <input class="grow" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onKeywordConfirm"
        confirm-type="search" placeholder="搜会员昵称或手机号，1 个字就能搜" />
      <text wx:if="{{keyword}}" class="muted" style="margin-right:12rpx" bindtap="clearKeyword">清空</text>
    </view>
    <view wx:if="{{memberLoading}}" class="muted mt">搜索中…</view>
    <view wx:elif="{{memberEmpty}}" class="muted mt">没有找到匹配「{{keyword}}」的会员</view>
    <view wx:if="{{members.length && !pickedMember}}" class="mt">
      <view wx:for="{{members}}" wx:key="_id" class="list-item" data-openid="{{item._id}}" bindtap="pickMember">
        <view class="grow">
          <view>{{item.name}}</view>
          <view class="muted">{{item.phone || '未填手机号'}}</view>
        </view>
        <text class="muted">选择</text>
      </view>
    </view>

    <view class="muted mt">教练可以帮会员拍并代发，动态会记在会员名下。</view>
  </view>

  <button class="btn block" bindtap="submit" disabled="{{submitting}}">发布</button>
</view>
