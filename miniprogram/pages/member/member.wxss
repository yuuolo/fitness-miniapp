.member-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  background: var(--fill);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 44rpx;
}

.title-sm {
  font-size: 28rpx;
  color: var(--ink);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-cell {
  width: 33.33%;
  padding: 16rpx 0;
  text-align: center;
}

.grid-v {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.grid-u {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 4rpx;
}

/* ---------- 和我 PK ---------- */
.pk-score {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.pk-side {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: var(--r-md);
}
.pk-side.win {
  background: var(--brand-soft);
}
.pk-who {
  font-size: 24rpx;
  color: var(--muted);
}
.pk-side.win .pk-who {
  color: var(--brand-strong);
}
.pk-num {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
}
.pk-side.win .pk-num {
  color: var(--brand);
}
.pk-vs {
  width: 160rpx;
  text-align: center;
}
.pk-vs-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--muted);
}
.pk-vs-d {
  display: block;
  font-size: 22rpx;
  color: var(--brand-strong);
}

.pk-rows {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}
.pk-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.pk-row:last-child {
  border-bottom: none;
}
.pk-name {
  width: 160rpx;
  color: var(--sub);
  font-size: 26rpx;
}
.pk-val {
  width: 130rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink);
}
.pk-val.better {
  color: var(--brand);
  font-weight: 600;
}
.pk-diff {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
.pk-diff.me {
  color: var(--brand);
}
.pk-diff.them {
  color: var(--danger);
}
.pk-note {
  font-size: 22rpx;
}

/* 体测报告图：完整显示，宽度撑满 */
.report {
  width: 100%;
  height: auto;
  display: block;
  border-radius: var(--r-sm);
  background: var(--fill);
}
