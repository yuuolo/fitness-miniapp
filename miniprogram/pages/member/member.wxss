.member-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  background: var(--fill);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 44rpx;
}

.title-sm {
  font-size: 28rpx;
  color: var(--ink);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-cell {
  width: 33.33%;
  padding: 16rpx 0;
  text-align: center;
}

.grid-v {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.grid-u {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 4rpx;
}
