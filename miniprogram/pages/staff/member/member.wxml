<view class="page" wx:if="{{member}}">
  <view class="card">
    <view class="title">{{member.nickName || '未设置昵称'}}</view>
    <view class="muted">{{member.phone || '未填手机号'}} · {{member.since}} 加入 · 积分 {{member.points || 0}}</view>
    <view wx:if="{{member.height}}" class="muted">身高 {{member.height}} cm</view>
    <view class="form-row" wx:if="{{isAdmin}}">
      <text class="label">角色</text>
      <picker range="{{roles}}" range-key="label" value="{{roleIndex}}" bindchange="changeRole">
        <view class="picker-text">{{roles[roleIndex].label}} ›</view>
      </picker>
    </view>
    <button class="btn ghost mt" bindtap="toggleProfile">{{editingProfile ? '收起' : '代填/修改资料'}}</button>
  </view>

  <view wx:if="{{editingProfile}}" class="card">
    <view class="form-row">
      <text class="label">昵称</text>
      <input value="{{profileForm.nickName}}" data-key="nickName" bindinput="onProfileInput" maxlength="20" placeholder="会员昵称" />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input type="number" value="{{profileForm.phone}}" data-key="phone" bindinput="onProfileInput" maxlength="11" placeholder="11 位手机号" />
    </view>
    <view class="form-row">
      <text class="label">性别</text>
      <picker range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGender">
        <view class="picker-text">{{genderOptions[genderIndex].label}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">身高(cm)</text>
      <input type="digit" value="{{profileForm.height}}" data-key="height" bindinput="onProfileInput" placeholder="选填，如 175" />
    </view>
    <button class="btn block mt" bindtap="saveProfile">保存资料</button>
    <view class="muted mt">手机号填了会员才能约课；这些信息会员自己也能在「我的」里改。</view>
  </view>

  <view class="card">
    <view class="list-item" bindtap="goFitness">
      <view class="grow">
        <view>身体数据与力量成绩</view>
        <view class="muted">{{member.latestBody && member.latestBody.score != null ? '身体评分 ' + member.latestBody.score : '尚未录入'}}</view>
      </view>
      <text class="muted">›</text>
    </view>
  </view>

  <block wx:if="{{manage}}">
    <view class="between section-title">
      <text>会员卡</text>
      <button class="btn" bindtap="toggleOpen">{{opening ? '收起' : '办卡'}}</button>
    </view>

    <view wx:if="{{opening}}" class="card">
      <view class="form-row">
        <text class="label">卡种</text>
        <picker range="{{types}}" range-key="label" value="{{form.typeIndex}}" data-field="typeIndex" bindchange="onPick">
          <view class="{{form.typeIndex >= 0 ? 'picker-text' : 'placeholder'}}">{{form.typeIndex >= 0 ? types[form.typeIndex].label : '请选择'}}</view>
        </picker>
      </view>
      <view class="form-row"><text class="label">实收（元）</text><input type="digit" value="{{form.amount}}" data-field="amount" bindinput="onInput" placeholder="可按实际优惠修改" /></view>
      <view class="form-row">
        <text class="label">收款方式</text>
        <picker range="{{payMethods}}" range-key="label" value="{{form.payIndex}}" data-field="payIndex" bindchange="onPick">
          <view class="picker-text">{{payMethods[form.payIndex].label}}</view>
        </picker>
      </view>
      <view class="form-row"><text class="label">备注</text><input value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="选填，如活动价" /></view>
      <button class="btn block mt" bindtap="submitCard">确认办卡</button>
    </view>

    <view class="card">
      <view wx:if="{{!cards.length}}" class="muted">还没有会员卡</view>
      <view wx:for="{{cards}}" wx:key="_id" class="list-item" data-index="{{index}}" bindtap="cardActions">
        <view class="grow">
          <view><text class="title">{{item.name}}</text> <text class="tag">{{item.kindName}}</text></view>
          <view class="muted">{{item.summary}}</view>
        </view>
        <text class="tag {{item.usable ? 'green' : 'red'}}">{{item.usable ? '可用' : item.statusName}}</text>
      </view>
      <view wx:if="{{cards.length}}" class="muted mt">点击卡片可调整次数、有效期、停卡或作废</view>
    </view>
  </block>

  <block wx:else>
    <view class="section-title">会员卡</view>
    <view class="card">
      <view wx:if="{{!cards.length}}" class="muted">还没有会员卡</view>
      <view wx:for="{{cards}}" wx:key="_id" class="list-item">
        <view class="grow">
          <view><text class="title">{{item.name}}</text> <text class="tag">{{item.kindName}}</text></view>
          <view class="muted">{{item.summary}}</view>
        </view>
        <text class="tag {{item.usable ? 'green' : 'red'}}">{{item.usable ? '可用' : item.statusName}}</text>
      </view>
      <view class="muted mt">办卡和调整次数请找前台</view>
    </view>
  </block>

  <view class="section-title">最近预约</view>
  <view class="card">
    <view wx:if="{{!bookings.length}}" class="muted">没有预约记录</view>
    <view wx:for="{{bookings}}" wx:key="_id" class="list-item">
      <view class="grow">
        <view>{{item.title}} <text class="tag">{{item.typeName}}</text></view>
        <view class="muted">{{item.timeText}}</view>
      </view>
      <text class="muted">{{item.statusName}}</text>
    </view>
  </view>

  <view class="section-title">最近入场</view>
  <view class="card">
    <view wx:if="{{!entries.length}}" class="muted">没有入场记录</view>
    <view wx:for="{{entries}}" wx:key="_id" class="list-item">
      <text class="grow">{{item.time}}</text>
      <text class="tag {{item.result === 'ok' ? 'green' : 'red'}}">{{item.result === 'ok' ? item.cardName : item.reason}}</text>
    </view>
  </view>
</view>
