<view class="page">
  <view wx:if="{{editing}}" class="card">
    <view class="title">{{form._id ? '编辑卡种' : '新增卡种'}}</view>
    <view class="form-row"><text class="label">名称</text><input value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="如：季卡" /></view>
    <view class="form-row">
      <text class="label">类型</text>
      <picker range="{{kinds}}" range-key="label" value="{{form.kindIndex}}" bindchange="onKind">
        <view class="picker-text">{{kinds[form.kindIndex].label}}</view>
      </picker>
    </view>
    <view wx:if="{{form.kindIndex !== 0}}" class="form-row"><text class="label">次数</text><input type="number" value="{{form.times}}" data-field="times" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">有效天数</text><input type="number" value="{{form.days}}" data-field="days" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">价格（元）</text><input type="digit" value="{{form.price}}" data-field="price" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">说明</text><input value="{{form.desc}}" data-field="desc" bindinput="onInput" placeholder="选填" /></view>
    <view class="form-row"><text class="label">上架</text><switch checked="{{form.onSale}}" color="#ff6a3d" bindchange="onSale" /></view>
    <view class="row mt">
      <button class="btn ghost grow" bindtap="close">取消</button>
      <view style="width:24rpx"></view>
      <button class="btn grow" bindtap="save">保存</button>
    </view>
  </view>

  <block wx:else>
    <button wx:if="{{isAdmin}}" class="btn block" bindtap="add">新增卡种</button>
    <view class="muted mt" wx:if="{{!isAdmin}}">只有管理员可以修改卡种。</view>
    <view class="card mt">
      <view wx:for="{{list}}" wx:key="_id" class="list-item" data-index="{{index}}" bindtap="edit">
        <view class="grow">
          <view><text class="title">{{item.name}}</text> <text class="tag">{{item.kindName}}</text> <text wx:if="{{!item.onSale}}" class="tag red">已下架</text></view>
          <view class="muted">{{item.rule}}{{item.desc ? ' · ' + item.desc : ''}}</view>
        </view>
        <text class="price">¥{{item.priceText}}</text>
      </view>
    </view>
  </block>
</view>
