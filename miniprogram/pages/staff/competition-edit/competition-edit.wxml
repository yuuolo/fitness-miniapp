<view class="page">
  <view class="card">
    <view class="form-row">
      <view class="label">竞赛名称</view>
      <input value="{{form.title}}" data-key="title" bindinput="onInput" maxlength="20" placeholder="例如：夏日卧推挑战赛" />
    </view>
    <view class="form-row">
      <view class="label">比赛项目</view>
      <picker mode="selector" range="{{lifts}}" range-key="name" value="{{liftIndex}}" bindchange="onLift">
        <view class="picker-text">{{lifts[liftIndex].name || '选择项目'}}（{{lifts[liftIndex].unit || ''}}）</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="label">开始</view>
      <view class="row grow">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDate"><view class="picker-text">{{startDate}}</view></picker>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTime"><view class="picker-text" style="margin-left: 20rpx">{{startTime}}</view></picker>
      </view>
    </view>
    <view class="form-row">
      <view class="label">结束</view>
      <view class="row grow">
        <picker mode="date" value="{{endDate}}" bindchange="onEndDate"><view class="picker-text">{{endDate}}</view></picker>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTime"><view class="picker-text" style="margin-left: 20rpx">{{endTime}}</view></picker>
      </view>
    </view>
    <view class="form-row">
      <view class="label">奖品</view>
      <input value="{{form.prize}}" data-key="prize" bindinput="onInput" maxlength="60" placeholder="例如：冠军 蛋白粉一桶" />
    </view>
    <view class="form-row">
      <view class="label">简介</view>
      <input value="{{form.desc}}" data-key="desc" bindinput="onInput" maxlength="200" placeholder="一句话说明" />
    </view>
  </view>

  <view class="card">
    <view class="muted">规则</view>
    <textarea value="{{form.rules}}" data-key="rules" bindinput="onInput" maxlength="500" placeholder="例如：每人每天可挑战一次，必须由教练见证并录像" style="width: 100%; min-height: 160rpx; margin-top: 12rpx" />
  </view>

  <button class="btn block" bindtap="save" disabled="{{saving}}">{{id ? '保存修改' : '发起竞赛'}}</button>
  <view class="muted" style="margin-top: 16rpx; text-align: center">发起后会员能在「排行榜 → 竞赛」里看到</view>
</view>
