<view class="page">
  <view wx:if="{{schedule}}" class="card">
    <view class="title">{{schedule.courseName}}</view>
    <view class="muted">{{schedule.time}} · {{schedule.coachName}}{{schedule.room ? ' · ' + schedule.room : ''}}</view>
    <view class="muted">已约 {{schedule.booked}}/{{schedule.capacity}}</view>
  </view>

  <view class="card">
    <view wx:if="{{!bookings.length}}" class="muted">还没有人预约</view>
    <view wx:for="{{bookings}}" wx:key="_id" class="list-item">
      <view class="grow">
        <view>{{item.memberName}}</view>
        <view class="muted" data-phone="{{item.memberPhone}}" bindtap="dial">{{item.memberPhone}}（点击拨打）</view>
      </view>
      <block wx:if="{{item.status === 'booked'}}">
        <button class="btn" data-index="{{index}}" data-status="attended" bindtap="mark">签到</button>
        <view style="width:12rpx"></view>
        <button class="btn gray" data-index="{{index}}" data-status="absent" bindtap="mark">缺席</button>
      </block>
      <text wx:else class="tag {{item.status === 'attended' ? 'green' : 'red'}}">{{item.statusName}}</text>
    </view>
  </view>
</view>
