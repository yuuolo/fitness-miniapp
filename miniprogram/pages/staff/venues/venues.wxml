<view class="page">
  <view wx:if="{{editing}}" class="card">
    <view class="title">{{form._id ? '编辑项目' : '新增项目'}}</view>
    <view class="form-row"><text class="label">名称</text><input value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="如：射箭馆" /></view>
    <view class="form-row"><text class="label">说明</text><input value="{{form.desc}}" data-field="desc" bindinput="onInput" placeholder="选填" /></view>
    <view class="form-row"><text class="label">开始营业（时）</text><input type="number" value="{{form.openHour}}" data-field="openHour" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">结束营业（时）</text><input type="number" value="{{form.closeHour}}" data-field="closeHour" bindinput="onInput" placeholder="24 表示营业到午夜" /></view>
    <view class="form-row"><text class="label">每时段名额</text><input type="number" value="{{form.capacity}}" data-field="capacity" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">每小时价格（元）</text><input type="digit" value="{{form.price}}" data-field="price" bindinput="onInput" /></view>
    <view class="form-row"><text class="label">开放预约</text><switch checked="{{form.onSale}}" color="#ff6a3d" bindchange="onSale" /></view>
    <view class="row mt">
      <button class="btn ghost grow" bindtap="close">取消</button>
      <view style="width:24rpx"></view>
      <button class="btn grow" bindtap="save">保存</button>
    </view>
  </view>

  <block wx:else>
    <button wx:if="{{isAdmin}}" class="btn block" bindtap="add">新增娱乐项目</button>
    <view class="muted mt" wx:if="{{!isAdmin}}">只有管理员可以修改娱乐项目。</view>
    <view class="card mt">
      <view wx:for="{{list}}" wx:key="_id" class="list-item" data-index="{{index}}" bindtap="edit">
        <view class="grow">
          <view><text class="title">{{item.name}}</text> <text wx:if="{{!item.onSale}}" class="tag red">已关闭</text></view>
          <view class="muted">{{item.openHour}}:00–{{item.closeHour}}:00 · 每时段 {{item.capacity}} 个名额{{item.desc ? ' · ' + item.desc : ''}}</view>
        </view>
        <text class="price">¥{{item.priceText}}/时</text>
      </view>
    </view>
  </block>
</view>
