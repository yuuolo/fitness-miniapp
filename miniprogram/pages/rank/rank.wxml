<view class="page">
  <view class="date-bar">
    <view wx:for="{{lifts}}" wx:key="key" class="d {{lift === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="pickLift">
      <view class="w">{{item.name}}</view>
    </view>
  </view>

  <view class="card">
    <view class="between">
      <text>排序方式</text>
      <view class="row">
        <text class="tag {{metric === 'absolute' ? 'orange' : ''}}" data-metric="absolute" bindtap="pickMetric">绝对重量</text>
        <text class="tag {{metric === 'relative' ? 'orange' : ''}}" data-metric="relative" bindtap="pickMetric">相对体重</text>
      </view>
    </view>
    <view wx:if="{{metric === 'relative'}}" class="muted mt">按「1RM ÷ 体重」排名。只有公开身体数据的会员才会出现在这个榜。</view>
    <view wx:else class="muted mt">按单次最大重量（1RM）排名。</view>
  </view>

  <view class="card">
    <view wx:if="{{loaded && board && !board.top.length}}" class="empty">还没有人上榜</view>
    <view wx:for="{{board.top}}" wx:key="openid" class="list-item">
      <text class="muted" style="width: 70rpx">{{item.rank}}</text>
      <view class="grow">
        <view>{{item.name}} <text wx:if="{{item.isMe}}" class="tag orange">我</text></view>
        <view wx:if="{{item.weight}}" class="muted">{{item.weight}} kg · 身体评分 {{item.bodyScore}}</view>
      </view>
      <text class="price">{{metric === 'relative' ? item.relative : item.oneRM}}{{metric === 'relative' ? ' 倍' : ' kg'}}</text>
    </view>
  </view>

  <view wx:if="{{board}}" class="card">
    <block wx:if="{{board.me}}">
      <view class="between">
        <text class="title">我的排名 第 {{board.me.rank}} 名</text>
        <text class="tag green">{{board.liftName}}</text>
      </view>
      <view class="muted mt">{{board.total}} 人上榜 · {{metric === 'relative' ? board.me.relative + ' 倍' : board.me.oneRM + ' kg'}}</view>
    </block>
    <view wx:else class="muted">你还没有{{board.liftName}}成绩；相对体重榜还需要先公开身体数据。</view>
  </view>
</view>
