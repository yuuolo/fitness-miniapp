page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
}

.page { padding: 24rpx 24rpx 48rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 4rpx 20rpx;
}

.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.muted { color: #8a8f99; font-size: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.price { color: #ff6a3d; font-weight: 600; }
.empty { text-align: center; color: #8a8f99; padding: 48rpx 0; }
.mt { margin-top: 16rpx; }

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f1f4;
  color: #5c6370;
  margin-right: 8rpx;
}
.tag.orange { background: #fff1eb; color: #ff6a3d; }
.tag.green { background: #e8f7ee; color: #1a9a4b; }
.tag.red { background: #fdecec; color: #d93a3a; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #ff6a3d;
  color: #fff;
  border: none;
  line-height: 60rpx;
  margin: 0;
}
.btn::after { border: none; }
.btn.ghost { background: #fff; color: #ff6a3d; border: 1px solid #ff6a3d; }
.btn.gray { background: #f0f1f4; color: #8a8f99; }
.btn.block { display: flex; width: 100%; height: 88rpx; border-radius: 44rpx; font-size: 30rpx; }
.btn[disabled] { opacity: 0.5; }

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f0f1f4;
}
.list-item:last-child { border-bottom: none; }

.date-bar {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx;
  margin-bottom: 24rpx;
}
.date-bar .d {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 14rpx;
}
.date-bar .d .w { font-size: 22rpx; color: #8a8f99; }
.date-bar .d .n { font-size: 32rpx; font-weight: 600; }
.date-bar .d.on { background: #ff6a3d; }
.date-bar .d.on .w, .date-bar .d.on .n { color: #fff; }

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f1f4;
}
.form-row .label { width: 180rpx; color: #5c6370; }
.form-row input, .form-row picker { flex: 1; }
.form-row .picker-text { color: #1f2329; }
.form-row .placeholder { color: #b8bcc4; }
