# 对外域名（仅在用自带 Caddy 方案时需要；有前置反代时可不填）
DOMAIN=gym.novrein.com

# 数据库密码，自己换一个强密码
POSTGRES_PASSWORD=change-me-please

# 小程序 AppID / AppSecret（mp.weixin.qq.com → 开发管理 → 开发设置）
WX_APPID=wx0000000000000000
WX_SECRET=your-app-secret-here

# ---------- 订阅消息（可选）----------
# 小程序后台「功能 → 订阅消息」选好模板后，把模板 ID 填在这里；留空则不发送该类通知。
# 字段名映射见 server/lib/templates.js，必须与模板里的 keyword 一致，
# 可用 wxaapi/newtmpl/gettemplate 接口核对自己模板的字段名。
WX_TPL_BOOKING_SUCCESS=
WX_TPL_CLASS_REMINDER=
WX_TPL_CARD_EXPIRE=

# 跳转的小程序版本：developer（开发版）/ trial（体验版）/ formal（正式版）
WX_MP_STATE=developer

# 课前提醒里展示的「场地地址」
SHOP_ADDRESS=前台签到

# 上传文件的对外地址前缀（小程序必须能直接访问，通常与对外域名一致）
PUBLIC_BASE_URL=https://gym.novrein.com
